# ===========================================
# НАСТРОЙКИ ДЛЯ РАЗНЫХ ПЛАТФОРМ РАЗВЕРТЫВАНИЯ
# ===========================================

# Frontend (Vercel)
VITE_API_URL=http://localhost:5000/api

# Для продакшена замените на:
# VITE_API_URL=https://your-backend-domain.render.com/api
# или
# VITE_API_URL=https://your-app.railway.app/api

# Backend
PORT=5000
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-change-in-production
CORS_ORIGIN=http://localhost:5173

# Для продакшена замените на:
# NODE_ENV=production
# CORS_ORIGIN=https://your-frontend-domain.vercel.app

# ===========================================
# ПЛАТФОРМЫ РАЗВЕРТЫВАНИЯ
# ===========================================

# Railway (платно от $5/мес)
# - Автоматическое развертывание из Git
# - Встроенная база данных
# - SSL сертификаты

# Render (бесплатно)
# - 750 часов в месяц бесплатно
# - Автоматическое развертывание
# - SSL сертификаты

# Heroku (платно)
# - Надежная платформа
# - Множество дополнений

# DigitalOcean App Platform
# - $5/мес за базовый план
# - Хорошая производительность
