{
  "version": 2,
  "name": "water-meter-app",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "VITE_API_URL": "https://water-meter-app-production.up.railway.app",
    "VITE_API_KEY": "AIzaSyByIiReJxgKGGcOs_2v_i9a5fbF40X_JGc"
  },
  "build": {
    "env": {
      "VITE_API_URL": "https://water-meter-app-production.up.railway.app",
      "VITE_API_KEY": "AIzaSyByIiReJxgKGGcOs_2v_i9a5fbF40X_JGc"
    }
  }
}
